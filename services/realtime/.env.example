GATEWAY_ADDR=:8080
MATCH_SERVICE_ADDR=:8082
PLATFORM_ADDR=:8083
MATCHMAKING_ADDR=:8084
MATCH_SERVICE_INTERNAL_URL=http://127.0.0.1:8082
PLATFORM_SERVICE_INTERNAL_URL=http://127.0.0.1:8083
MATCHMAKING_SERVICE_INTERNAL_URL=http://127.0.0.1:8084
MATCH_ARCHIVE_BACKEND=file
MATCH_ARCHIVE_PATH=data/match-archive.json
MATCH_ARCHIVE_SQLITE_PATH=data/match-archive.sqlite
MATCH_ARCHIVE_POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/chess404?sslmode=disable
GUEST_STORE_BACKEND=file
GUEST_STORE_PATH=data/guest-profiles.json
GUEST_STORE_SQLITE_PATH=data/guest-profiles.sqlite
GUEST_STORE_POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/chess404?sslmode=disable
ACCOUNT_STORE_BACKEND=file
ACCOUNT_STORE_PATH=data/accounts.json
ACCOUNT_STORE_SQLITE_PATH=data/accounts.sqlite
ACCOUNT_STORE_POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/chess404?sslmode=disable
MATCH_CLAIM_STORE_BACKEND=memory
MATCH_CLAIM_STORE_REDIS_URL=redis://127.0.0.1:6379/0
MATCH_CLAIM_STORE_REDIS_KEY=chess404:platform:match-claims
MATCH_CLAIM_STORE_TTL_SECONDS=43200
MATCHMAKING_TICKET_STORE_BACKEND=file
MATCHMAKING_TICKET_STORE_PATH=data/matchmaking-tickets.json
MATCHMAKING_TICKET_STORE_SQLITE_PATH=data/matchmaking-tickets.sqlite
MATCHMAKING_TICKET_STORE_REDIS_URL=redis://127.0.0.1:6379/0
MATCHMAKING_TICKET_STORE_REDIS_KEY=chess404:matchmaking:tickets

# Account email delivery (password-reset mails).
# `preview` (default) only logs the reset link; `smtp` sends real email;
# `disabled` drops it.
#ACCOUNT_EMAIL_DELIVERY_PROVIDER=preview
#ACCOUNT_EMAIL_SMTP_ADDRESS=smtp.example.com:587
#ACCOUNT_EMAIL_SMTP_FROM=no-reply@example.com
#ACCOUNT_EMAIL_SMTP_USERNAME=
#ACCOUNT_EMAIL_SMTP_PASSWORD=
# Required true for any non-loopback SMTP host.
#ACCOUNT_EMAIL_SMTP_TLS=true
#ACCOUNT_EMAIL_SMTP_FROM_NAME=Chess404
#ACCOUNT_EMAIL_SMTP_REPLY_TO=
#ACCOUNT_EMAIL_SMTP_MESSAGE_DOMAIN=
